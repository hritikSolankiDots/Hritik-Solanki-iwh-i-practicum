doctype html
html
  head
    title= title
    link(rel='stylesheet', href='/css/style.css')
  body
    h1 Create New Custom Object
    
    a(href='/') Return to the homepage
    
    form(action='/update-cobj', method='POST')
      div.form-group
        label(for='name') Name:
        input(type='text', id='name', name='name', required)
      
      div.form-group
        label(for='author') Author:
        input(type='text', id='author', name='author', required)
      
      div.form-group
        label(for='publicationyear') Publication Year:
        input(type='number', id='publicationyear', name='publicationyear', required)
      
      button(type='submit') Create Custom Object