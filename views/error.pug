doctype html
html
  head
    title Error | Book Collection Dashboard
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet', href='/css/style.css')
  body
    header.header
      div.container.header-content
        h1 Error Occurred
    
    main.container
      div.card
        div.card-header
          h2.card-title Something went wrong
          a.back-link(href='/')
            svg(xmlns='http://www.w3.org/2000/svg', width='16', height='16', fill='currentColor', viewBox='0 0 16 16')
              path(fill-rule='evenodd', d='M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z')
            span Return to Dashboard
        
        div.card-body
          div.error-message
            svg(xmlns='http://www.w3.org/2000/svg', width='64', height='64', fill='#dc3545', viewBox='0 0 16 16')
              path(d='M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z')
              path(d='M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z')
            p.error-text= message || 'An unexpected error occurred. Please try again.'